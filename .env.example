# Frontend (build-time)
VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_BASE_PATH=/

# Server
NODE_ENV=development
PORT=3000
JWT_SECRET=dev-uet-phdhub-secret-change-in-production
ADMIN_EMAIL=tuyenkv@vnu.edu.vn
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
ALLOW_DEV_LOGIN=true
SEED_DEMO=true

# Database: turso (SQLite local or Turso libSQL remote) or d1 (Cloudflare D1 REST)
DB_PROVIDER=turso
TURSO_DATABASE_URL=file:./phdhub-uet.db
TURSO_AUTH_TOKEN=

# Production Cloudflare D1 REST (Provisioned in APAC)
CLOUDFLARE_ACCOUNT_ID=45ac1d4c947c9bee3f0e06c0823497d7
CLOUDFLARE_DATABASE_ID=23107947-b363-4a0f-acd0-32359db59884
CLOUDFLARE_API_TOKEN=

# Production Cloudflare R2 (PDF & evidence storage; falls back to .storage/ in dev)
R2_ACCOUNT_ID=45ac1d4c947c9bee3f0e06c0823497d7
R2_ENDPOINT=https://45ac1d4c947c9bee3f0e06c0823497d7.r2.cloudflarestorage.com
R2_BUCKET=uet-phdhub-documents
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Email queue (brevo | resend | none)
EMAIL_PROVIDER=none
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Phòng Công tác sinh viên UET <no-reply@uet.vnu.edu.vn>
EMAIL_DAILY_SEND_CAP=250
EMAIL_BATCH_SIZE=25
EMAIL_SEND_IMMEDIATE=false

# Cron secret for GitHub Actions daily reminders / email drain
CRON_SECRET=change-this-cron-secret
